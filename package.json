{
  "name": "ftransfer",
  "version": "1.0.0",
  "private": true,
  "description": "Private file transfer on Cloudflare Workers + R2",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "wrangler dev",
    "build:client": "tsc -p client",
    "deploy": "wrangler deploy",
    "types": "wrangler types --env-file .dev.vars.example --strict-vars=false",
    "typecheck": "pnpm run types && tsc -p . && tsc -p client --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test \"test/*.test.ts\"",
    "smoke": "node --experimental-strip-types --no-warnings scripts/smoke.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.159.0"
  }
}
